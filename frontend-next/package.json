{
  "name": "frontend-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:coverage:verify": "vitest run --coverage && node scripts/verify-coverage.mjs",
    "test:contract": "vitest run --coverage --coverage.thresholds.lines=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.statements=0 tests/openapi.validation.test.ts",
    "test:e2e": "node ./scripts/run-playwright.mjs",
    "test:performance": "playwright test tests/playwright/performance.spec.ts"
  },
  "dependencies": {
    "google-auth-library": "^10.4.0",
    "next": "16.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "swr": "^2.3.6",
    "uuid": "^9.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^8.6.7",
    "@storybook/addon-essentials": "^8.6.7",
    "@storybook/addon-interactions": "^8.6.7",
    "@storybook/addon-links": "^8.6.7",
    "@storybook/blocks": "^8.6.7",
    "@storybook/nextjs": "^8.6.7",
    "@storybook/react": "^8.6.7",
    "@storybook/test": "^8.6.7",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "13.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.3",
    "browserslist": "^4.26.2",
    "caniuse-lite": "^1.0.30001746",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "msw": "^2.11.3",
    "prettier": "^3.6.2",
    "storybook": "^8.6.7",
    "tailwindcss": "^4.1.16",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
